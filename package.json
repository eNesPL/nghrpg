{
  "name": "nghrpg",
  "version": "1.0.0",
  "description": "Never Going Home game system for Foundry VTT",
  "private": true,
  "main": "scripts/ngh-system.js",
  "scripts": {
    "clean": "rimraf dist scripts templates styles lang system.json",
    "build": "run-s clean build:ts build:assets",
    "build:ts": "tsc -p .",
    "build:assets": "node tools/build-assets.mjs",
    "sync:foundry": "run-s build sync:foundry:files",
    "sync:foundry:files": "node tools/sync-to-foundry.mjs",
    "watch": "run-p watch:ts watch:assets",
    "watch:ts": "tsc -p . --watch",
    "watch:assets": "node tools/build-assets.mjs --watch"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@league-of-foundry-developers/foundry-vtt-types": "^12.331.4",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  }
}
